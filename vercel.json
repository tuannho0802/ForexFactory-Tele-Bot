{
  "version": 2,
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "dist/main.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/webhook/telegram",
      "dest": "dist/main.js"
    },
    {
      "src": "/api/health",
      "dest": "dist/main.js"
    },
    {
      "src": "/api/cron/scan",
      "dest": "dist/main.js"
    },
    {
      "src": "/api/cron/morning",
      "dest": "dist/main.js"
    },
    {
      "src": "/api/cron/alerts",
      "dest": "dist/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/main.js"
    }
  ]
}
