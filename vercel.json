{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "dist/main.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/webhook/telegram",
      "dest": "/dist/main.js"
    },
    {
      "src": "/api/health",
      "dest": "/dist/main.js"
    },
    {
      "src": "/api/cron/(.*)",
      "dest": "/dist/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/main.js"
    }
  ]
}
